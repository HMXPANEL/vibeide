<FrameLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/crash_popup_root"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@android:color/transparent"
  android:padding="12dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/crash_popup_background"
    android:padding="20dp">

    <TextView
      android:id="@+id/crash_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/msg_ide_crashed"
      android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />

    <TextView
      android:id="@+id/crash_summary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
      tools:text="Crash reason:\njava.lang.NullPointerException\nMessage:\n...\nThread:\nmain" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:gravity="end"
      android:orientation="horizontal">

      <Button
        android:id="@+id/crash_overlay_view_log"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_crash_view_log" />

      <Button
        android:id="@+id/crash_overlay_copy"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_copy_report_action" />

      <Button
        android:id="@+id/crash_overlay_close"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_crash_close" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
